# LangBar Core Example App Environment Variables
# Copy this file to .env and fill in your actual API keys

# Primary OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key for fast inference
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key for accessing various models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Custom LLM Base URL (optional)
LLM_BASE_URL=your_custom_llm_base_url_here

# PineCone Vector Store Base URL (optional)
VECTOR_STORE_BASE_URL=your_vector_store_base_url_here
PINECONE_API_KEY=your_pinecone_api_key

# Pinecone Vector Database Configuration (needed for general question answering using RAG; You can postpone adding this; the rest of the speech-enablement works as long as you don't ask general questions that use RAG.
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here
