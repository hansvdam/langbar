# LangBar Core Example App Environment Variables
# Copy this file to .env and fill in your actual API keys

# Primary OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key for fast inference
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key for accessing various models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here

# Encryption Configuration for secure storage
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_IV=your_16_character_initialization_vector_here

# Optional: Ollama Configuration (for local LLM hosting)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Optional: Custom LLM Base URLs
# CUSTOM_LLM_BASE_URL=https://your-custom-llm-endpoint.com/v1